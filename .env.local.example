# Firebase Web SDK config — Firebase Console > Project settings > Your apps > Web app
# These are PUBLIC by design. Your security comes from Firestore/Storage rules, not secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=manvi-s-portfolio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=manvi-s-portfolio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=manvi-s-portfolio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The single UID allowed into /admin. Get it from Firebase Console > Authentication > Users.
NEXT_PUBLIC_ADMIN_UID=

NEXT_PUBLIC_SITE_URL=https://manvigurjar.com
NEXT_PUBLIC_GA_ID=

# NEVER put the service account private key here or anywhere in this repo.
