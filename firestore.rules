rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'PvU0uS7iJ5fOx5bETBVbhs9Npz53' ||
        request.auth.uid == 'tIlyhAFaKsVXdATXm2FgvxWQ75r2' ||
        request.auth.uid == 'ZCbz9gIhb9dybGHv8JqFvowFnCz1'
      );
    }

    match /blogs/{blogId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasAll(['name','email','subject','message','status','createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 120
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 5000
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /case-studies/{caseStudyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
